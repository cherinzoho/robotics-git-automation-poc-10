branch=$(git rev-parse --abbrev-ref HEAD)

# Allow main and develop to push without validation
if echo "$branch" | grep -qE "^(main|develop)$"; then
  exit 0
fi

# Branch name validation rules from devops/project.env:
#   Ticket branches    : type/TICKET-ID-short-description
#   Release branches   : release/MAJOR.MINOR.PATCH
#   Experiment branches: experiment/topic-name  (no ticket ID required)
#
# Ticket types: feature bugfix hotfix refactor sim
# Ticket ID pattern: [A-Z][A-Z0-9]*-[0-9]+
PATTERN="^(feature|bugfix|hotfix|refactor|sim)/[A-Z][A-Z0-9]*-[0-9]+-[a-z0-9-]+$|^release/[0-9]+\.[0-9]+\.[0-9]+$|^experiment/[a-z0-9][a-z0-9-]*$"

if ! echo "$branch" | grep -qE "$PATTERN"; then
  echo ""
  echo "  ✖  Branch name '$branch' does not follow convention"
  echo ""
  echo "  Valid formats:"
  echo ""
  echo  $t/ARM-42-short-description
  echo  $t/ARM-42-short-description
  echo  $t/ARM-42-short-description
  echo  $t/ARM-42-short-description
  echo  $t/ARM-42-short-description
  echo "    release/1.4.0               ← version number, no ticket ID"
  echo "    experiment/topic-name       ← free-form, no ticket ID"
  echo ""
  echo "  Ticket ID format: [A-Z][A-Z0-9]*-[0-9]+  (e.g. ARM-42)"
  echo "  Ticket types:     feature bugfix hotfix refactor sim"
  echo ""
  exit 1
fi

echo "  Branch name '$branch' is valid"
exit 0
